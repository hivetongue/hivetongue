{
  // Cloudflare Workers config for Hivetongue
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hivetongue",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/assets/radio/*"] }, // radio tracks get Range support from the Worker
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hivetongue",
      "database_id": "a1c7710b-f075-4493-b2f7-26d6f6f2cbc4",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "hivetongue.com", "custom_domain": true }],
  // in-memory rate limits (no database writes); period must be 10 or 60 seconds
  "ratelimits": [
    { "name": "IP_RL", "namespace_id": "7101", "simple": { "limit": 60, "period": 60 } },
    { "name": "MSG_RL", "namespace_id": "7102", "simple": { "limit": 30, "period": 60 } },
    { "name": "NEW_RL", "namespace_id": "7103", "simple": { "limit": 5, "period": 60 } },
    { "name": "PING_RL", "namespace_id": "7104", "simple": { "limit": 6, "period": 60 } }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "MSG_PER_MIN": "30", "REG_PER_HOUR": "5", "HOUSE": "1", "HOUSE_RATE": "0.6",
    "POW_BITS": "20", "PROBATION_H": "24", "REG_GLOBAL_PER_HOUR": "100" },
  "observability": { "enabled": true }
}
